              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def accountNo = vars.get(&quot;accountNo&quot;)
def balance   = vars.get(&quot;balance&quot;)

def file = new File(&quot;C:/Users/Yasaswini/OneDrive/Desktop/Jmeter/File_extraction_Jmetr/account_balance_data.csv&quot;)

 if (!file.exists()) 
 
       {
        file.append(&quot;AccountNo,Balance\n&quot;)
   	 }

    
 file.append(&quot;${accountNo},${balance}\n&quot;)

 
</stringProp>
